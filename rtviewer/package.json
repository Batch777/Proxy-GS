  "scripts": {
    "dev": "node -e \"const c=require('child_process');if(process.platform==='win32'){c.spawn('wsl',['-d','Ubuntu-22.04','--','/home/steven/.local/node/bin/node','/home/steven/Proxy-GS/rtviewer/server.js',...process.argv.slice(1)],{stdio:'inherit'})}else{c.spawn(process.execPath,['/home/steven/Proxy-GS/rtviewer/server.js',...process.argv.slice(1)],{stdio:'inherit'})}\" --",
